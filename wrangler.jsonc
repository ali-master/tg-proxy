{
  // Used by the "Deploy to Cloudflare" button and by `npx wrangler deploy`.
  // Docs: https://developers.cloudflare.com/workers/platform/deploy-buttons/
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tg-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  // Workers Logs: per-stream [tgproxy] lines across all isolates (dashboard → Logs).
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
